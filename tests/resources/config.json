{
  "default": [
    {
      "type": "openai",
      "models": [
        "gpt-4o",
        "gpt-4o-mini"
      ],
      "api_key": "***",
      "base_url": "https://api.openai.com/v1"
    },
    {
      "type": "openai",
      "models": [
        "deepseek-chat",
        "deepseek-coder"
      ],
      "api_key": "***",
      "base_url": "https://api.deepseek.com/v1"
    }
  ],
  "azure": [
    {
      "type": "azure",
      "models": [
        "gpt-4o"
      ],
      "api_key": "***",
      "azure_endpoint": "https://***.openai.azure.com/",
      "api_version": "2024-02-15-preview"
    }
  ],
  "alias": [
    {
      "type": "alias",
      "alias": {
        "azure-4o": "azure/gpt-4o",
        "deepseek": "deepseek-chat"
      }
    }
  ],
  "multi/level": [
    {
      "type": "alias",
      "alias": {
        "4o": "alias/azure-4o"
      }
    }
  ]
}